# 构建产物（80 MB 的 dll 与大堆中间文件，绝不入库）
/dist/

# 探针脚本的产出（截图、日志、临时 JSON）
/tmp/

# Deno / Node
# 注意：deno.lock 必须入库 —— 它是依赖可复现的保证，不要忽略它。
/node_modules/

# 编辑器与本机环境
.vscode/
.idea/
*.local

# 本机机密（隐私红线：绝不入库）
.env
.env.*
!.env.example

# 官网（Nuxt）的依赖与构建产物：源码入库，产物不入库
website/node_modules/
website/.nuxt/
website/.output/
website/dist/
website/_build_bak/
website/.data/

# 密钥绝不入库（旧工程 scripts/ 里带出来的）
*.pem
*.key
**/ed25519-private.pem
key-info.json
